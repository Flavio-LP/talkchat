# Chalk Talk backend — production image (used by docker-compose.prod.yml).
FROM ruby:3.2.8-slim AS build

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      libyaml-dev \
      git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN gem install bundler -v 2.6.6

ENV RAILS_ENV=production \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_FROZEN=1

COPY Gemfile Gemfile.lock ./
RUN bundle install && rm -rf "$GEM_HOME"/cache/*.gem

FROM ruby:3.2.8-slim

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      libpq5 \
      libyaml-0-2 \
      curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN gem install bundler -v 2.6.6

ENV RAILS_ENV=production \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_FROZEN=1 \
    RAILS_LOG_TO_STDOUT=1

COPY --from=build /usr/local/bundle /usr/local/bundle
COPY . .

RUN bundle exec bootsnap precompile app/ lib/ || true

RUN groupadd --system rails && useradd --system --gid rails --create-home rails \
    && chown -R rails:rails /app
USER rails

EXPOSE 3000

CMD ["bundle", "exec", "puma", "-C", "config/puma.rb", "-b", "tcp://0.0.0.0:3000"]
