# Chalk Talk — backend environment
# Copy to .env and fill in. .env is gitignored and must never be committed.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model name lives in ENV on purpose: the Gemini catalog rotates roughly every
# 6 months. See https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_MODEL=gemini-3.6-flash

# Leave DATABASE_HOST empty to connect over the local Unix socket (peer auth),
# which is what a passwordless `CREATE ROLE ... WITH LOGIN CREATEDB` supports.
# Set it to localhost only together with a DATABASE_PASSWORD, because the
# default pg_hba.conf answers TCP connections with scram-sha-256.
DATABASE_HOST=
DATABASE_PORT=5433
DATABASE_USERNAME=flavio
DATABASE_PASSWORD=

REDIS_URL=redis://localhost:6379/1

# Comma-separated list. Vite falls back to 5174 when 5173 is taken.
CORS_ORIGINS=http://localhost:5173

# Shared secret gating every /api/v1 request (there is no per-user auth, just
# one owner). Generate with: openssl rand -hex 24
APP_ACCESS_TOKEN=
